@test "valid forms mid-test" {
  run ! grep -q x f
  ! grep -q x f || false
  ! cat f | grep -q x || false
  if grep -q x f; then false; fi
  ! grep -q x f || false # why
  [ ! -f f ]
  [[ ! -d d ]]
  [[ a == a && ! -d d ]]
  if ! grep -q x f; then true; fi
  while ! test -f f; do sleep 1; done
  x=$(echo "!")
  y=$(! grep -q x f; echo $?)
  true
}
@test "bare as last command" {
  true
  ! grep -q x f
  # trailing comment
}
@test "last in an if" {
  true
  if a; then
    ! grep -q x f
  fi
}
