#!/usr/bin/env bash
# ecr-models-check — confirm the ECR panel the LiteLLM key offers can run:
# a thin caller of ecr-panel-resolve (CCW-193).
#
#   ecr-models-check [--models ID[,ID...]]
#
#   (none)     resolve the three ecr-* slots (ecr-panel-resolve --out FILE).
#              Only the output budgets are priced: there is no prompt here.
#   --models   check that each id is on the key (GET /v1/models) and priced
#              (ecr-panel-resolve --models IDS --verify --out FILE)
#
# Reads LITELLM_URL (default https://litellm.screenfields.net) and
# LITELLM_API_KEY. Without the key it prints "skipped: no LITELLM_API_KEY"
# and exits 0 without a call. The resolver passes the key to curl only
# through a mode-600 header file (curl -H @file), never argv. The temporary
# directory with the panel file is removed on every exit.
# Exit: 0 panel resolves (or skipped); 1 partial panel, fewer than two slots,
# a missing id or the cost check refused (each DROPPED:, MISSING: or REFUSED:
# line is shown); 2 usage error or lookup failure.
set -u

models=""
have_models=0
while [ $# -gt 0 ]; do
  case "$1" in
    --models) [ $# -ge 2 ] || { echo "usage: ecr-models-check [--models ID[,ID...]]" >&2; exit 2; }
              have_models=1; models="$2"; shift 2 ;;
    *) echo "usage: ecr-models-check [--models ID[,ID...]]" >&2; exit 2 ;;
  esac
done

if [ -z "${LITELLM_API_KEY:-}" ]; then
  echo "skipped: no LITELLM_API_KEY"
  exit 0
fi

resolver="$(dirname "$0")/ecr-panel-resolve"
tmp=$(mktemp -d) || { echo "ecr-models-check: mktemp failed" >&2; exit 2; }
trap 'rm -rf "$tmp"' EXIT

if [ "$have_models" -eq 1 ]; then
  "$resolver" --models "$models" --verify --out "$tmp/panel.tsv"
else
  "$resolver" --out "$tmp/panel.tsv"
fi
rc=$?
case "$rc" in
  0) exit 0 ;;
  1|4|5) exit 1 ;;
  *) exit 2 ;;
esac
