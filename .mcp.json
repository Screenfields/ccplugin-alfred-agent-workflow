{
  "mcpServers": {
    "agent-messaging": {
      "type": "http",
      "url": "${AGENT_MESSAGING_URL:-https://agent-messaging.screenfields.dev/mcp/}",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}",
        "Authorization": "Bearer ${AGENT_MESSAGING_TOKEN}",
        "X-Agent-ID": "${AGENT_ID}"
      }
    }
  }
}
